generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String          @id @default(cuid())
  clerkUserId   String?         @unique
  name          String?
  email         String          @unique
  demoOutcome   String          @default("SUCCESS")
  createdAt     DateTime        @default(now())
  wallet        Wallet?
  cards         VirtualCard[]
  intents       PaymentIntent[]
  transactions  Transaction[]
  ledgerEntries LedgerEntry[]
}

model Wallet {
  id                   String   @id @default(cuid())
  userId               String   @unique
  currency             String   @default("NGN")
  availableBalanceKobo Int      @default(0)
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VirtualCard {
  id           String   @id @default(cuid())
  userId       String
  provider     String   @default("MOCK_CLEVA")
  currency     String   @default("USD")
  status       String   @default("ACTIVE")
  maskedPan    String
  balanceCents Int      @default(0)
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Merchant {
  id        String          @id @default(cuid())
  slug      String          @unique
  name      String
  supported Boolean         @default(true)
  intents   PaymentIntent[]
}

model PaymentIntent {
  id            String        @id @default(cuid())
  userId        String
  merchantId    String?
  inputText     String?
  inputUrl      String?
  planId        String?
  planName      String?
  interval      String?
  confidence    Float
  status        String        @default("AWAITING_APPROVAL")
  createdAt     DateTime      @default(now())
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchant      Merchant?     @relation(fields: [merchantId], references: [id])
  quote         Quote?
  transaction   Transaction?
  ledgerEntries LedgerEntry[]

  @@index([userId, createdAt])
}

model Quote {
  id               String        @id @default(cuid())
  intentId         String        @unique
  usdAmountCents   Int
  fxRateNgnPerUsd  Int
  convertedNgnKobo Int
  feeNgnKobo       Int
  totalNgnKobo     Int
  assumptions      String
  expiresAt        DateTime
  createdAt        DateTime      @default(now())
  intent           PaymentIntent @relation(fields: [intentId], references: [id], onDelete: Cascade)
  transactions     Transaction[]
}

model Transaction {
  id                String        @id @default(cuid())
  userId            String
  intentId          String        @unique
  quoteId           String
  status            String
  usdAmountCents    Int
  totalNgnKobo      Int
  authorizationCode String?
  declineReason     String?
  receiptId         String        @unique
  idempotencyKey    String        @unique
  createdAt         DateTime      @default(now())
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  intent            PaymentIntent @relation(fields: [intentId], references: [id], onDelete: Cascade)
  quote             Quote         @relation(fields: [quoteId], references: [id])
}

model LedgerEntry {
  id           String         @id @default(cuid())
  userId       String
  intentId     String?
  account      String
  type         String
  currency     String
  amount       Int
  balanceAfter Int
  reference    String
  createdAt    DateTime       @default(now())
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  intent       PaymentIntent? @relation(fields: [intentId], references: [id])

  @@index([userId, createdAt])
}
